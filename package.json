{
  "name": "keynote-pdf-branch-merger",
  "version": "1.0.0",
  "description": "Merge the annotated pages of a Keynote (ahead) PDF into its (complete) PDF, in the browser",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "fixtures": "uv run --with pymupdf scripts/make_fixtures.py",
    "build": "node scripts/make_icons.mjs && node scripts/pack.mjs",
    "icons": "node scripts/make_icons.mjs",
    "demo": "node scripts/record_demo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "lucide-static": "^1.51.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "puppeteer-core": "^25.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chatchavan/keynote-pdf-branch-merger.git"
  }
}
